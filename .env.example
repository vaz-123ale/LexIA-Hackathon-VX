# Copie este arquivo para .env (na mesma pasta) só se quiser ligar a IA generativa.
# SEM CHAVE, A LEXIA RODA INTEIRA em modo controlado: regras versionadas, busca local nas normas e respostas conferidas.

# Opção 1 — Google Gemini (usada na demonstração)
GEMINI_API_KEY=

# Opção 2 — Anthropic
# ANTHROPIC_API_KEY=

# Opção 3 — Amazon Bedrock (caminho de implantação; usa as credenciais AWS da máquina)
# TORRE_LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1

# Teto diário de chamadas pagas de IA (padrão 300)
# TORRE_LLM_MAX_CALLS_DIA=300
